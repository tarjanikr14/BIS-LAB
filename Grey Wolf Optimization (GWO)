import numpy as np

def fitness(x):
    return np.sum(x**2)

def GWO(n_wolves=30, iterations=100, dim=2):

    wolves = np.random.uniform(-10, 10, (n_wolves, dim))

    for t in range(iterations):

        sorted_wolves = sorted(wolves, key=fitness)

        alpha = sorted_wolves[0]
        beta = sorted_wolves[1]
        delta = sorted_wolves[2]

        a = 2 - 2 * t / iterations

        new_wolves = []

        for wolf in wolves:

            positions = []

            for leader in [alpha, beta, delta]:

                A = 2 * a * np.random.rand(dim) - a
                C = 2 * np.random.rand(dim)

                D = np.abs(C * leader - wolf)
                X = leader - A * D

                positions.append(X)

            new_position = np.mean(positions, axis=0)
            new_position = np.clip(new_position, -10, 10)

            new_wolves.append(new_position)

        wolves = np.array(new_wolves)

    best = min(wolves, key=fitness)

    return best, fitness(best)


best, score = GWO()

print("Best Solution:", best)
print("Best Fitness:", score)
